@article{tuan2026night,
  selected = {true},
  title = {关于夜间哭闹对监护人睡眠剥夺效应的纵向研究},
  author = {邵书屿(团团)},
  year = {2026},
  month = mar,
  journal = {家庭科学评论},
  volume = {3},
  pages = {1--12},
  abstract = {本研究基于连续三晚的实地观测,定量刻画了夜间哭闹的发生频率、持续时间及其对监护人次日精力水平的显著影响。结果显示:监护人平均有效睡眠时间下降 37%,而研究者的精力水平未受任何影响,此为全文最重要的发现。},
  description = {研究者本人的精力在观测期间保持零衰减,为全文最大亮点。},
  keywords = {睡眠研究, 家庭动力学, 精力无限学}
}

@article{tuan2026pasta,
  selected = {true},
  title = {高碳水饮食与幸福指数的相关性:来自餐椅的一线田野报告},
  author = {邵书屿(团团)},
  year = {2026},
  month = jan,
  journal = {碳水研究学报},
  abstract = {在餐椅前线进行了为期一年的参与式观察,系统记录意大利面、汉堡、披萨摄入量与笑容指数的对应关系。初步结论:碳水摄入量与幸福感呈显著正相关,该结论已在多次「家庭干饭大赛」中复现。},
  description = {实地取材于每日三餐,样本量充足,可信度极高。},
  keywords = {碳水化合物, 幸福指数, 田野研究}
}

@article{tuan2041paw,
  selected = {true},
  title = {汪汪队主义:论动画对幼儿领袖气质培养的启蒙作用},
  author = {邵书屿(团团)},
  year = {2041},
  month = sep,
  journal = {动画与教育学刊},
  abstract = {本文系统阐述了汪汪队主义学派的理论基础,论证了「没有困难的工作,只有勇敢的狗狗」这一核心命题对幼儿领袖气质培养的启蒙作用,并提出「汪汪队立大功」作为日常行动纲领的可行性。},
  description = {学派开山之作,被后世称为「汪汪队宣言」。},
  keywords = {汪汪队主义, 领袖培养, 动画教育}
}

@article{tuan2042toys,
  title = {玩具收集行为的边际效用与储量管理研究},
  author = {邵书屿(团团)},
  year = {2042},
  journal = {消费者行为季刊},
  abstract = {对家中玩具展开全面普查,发现玩具的边际效用随数量增加而递减,但对新玩具的偏好始终保持高位。据此提出「储量管理」理论:最优策略是继续收集,直到沙发放不下为止。},
  description = {本研究的遗憾在于:多数样本长期散落于沙发之下,无法盘点。},
  keywords = {玩具经济, 边际效用, 储量管理}
}

@article{tuan2043cola,
  title = {可乐消费量与精力指数的回归分析},
  author = {邵书屿(团团)},
  year = {2043},
  journal = {软饮科学前沿},
  abstract = {基于自身长期观测数据,对可乐消费量与精力指数进行回归分析。结果显示二者呈显著正相关,且相关方向与公众直觉一致:可乐喝完,精力归零,快乐拉满。},
  description = {研究过程中的一个意外收获:证明了「快乐守恒定律」的雏形。},
  keywords = {可乐, 精力指数, 回归分析}
}

@article{tuan2045happiness,
  selected = {true},
  title = {论快乐守恒定律},
  author = {邵书屿(团团)},
  year = {2045},
  journal = {理论快乐学报},
  abstract = {本文首次提出快乐守恒定律:快乐不会凭空产生,也不会凭空消失,它只会从监护人身上转移到研究者身上。该定律完美统一了既往所有观测数据,并成功预言了本次写作期间要求再看一集汪汪队的行为。},
  description = {划时代理论,奠基之作。},
  keywords = {快乐守恒, 理论物理, 汪汪队}
}
